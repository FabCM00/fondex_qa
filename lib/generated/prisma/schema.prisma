// El cliente se genera dentro del repo (no en node_modules): con pnpm el
// enlace `.prisma/client` que espera `@prisma/client` no siempre queda donde
// lo busca, y `tsx` (ESM puro) falla al importarlo. Generarlo aqui hace que la
// ruta sea explicita y funcione igual en Next y en los scripts.
generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// AUTENTICACION (Better Auth)
//
// Es lo unico que este proyecto crea en la base. Las tablas de datos de abajo
// ya existian en coopvalili_db con datos productivos y se describen tal como
// estan (ver prisma/migrations/*_baseline_datos_motor).
//
// Los roles son solo ADMIN y COLABORADOR. La base venia con USER del sistema
// anterior: la migracion convierte esas filas a COLABORADOR y saca el valor
// del enum.
// ---------------------------------------------------------------------------

enum Role {
  ADMIN
  COLABORADOR
}

/// Usuario de la aplicacion. Better Auth es el dueno de esta tabla:
/// la contrasena vive hasheada en Account, no aqui.
model User {
  id               String   @id @default(cuid())
  name             String
  email            String   @unique
  emailVerified    Boolean  @default(false)
  image            String?
  role             Role     @default(COLABORADOR)
  active           Boolean  @default(false)
  /// Segundo factor activo. Solo aplica al login con contrasena: quien entra
  /// por Microsoft ya paso el MFA de Entra ID.
  twoFactorEnabled Boolean  @default(false)
  createdAt        DateTime @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  sessions   Session[]
  accounts   Account[]
  twoFactors TwoFactor[]

  @@index([email], map: "idx_user_email")
  @@index([role], map: "idx_user_role")
}

/// Sesion activa. El token es el que viaja en la cookie httpOnly y es lo que
/// autoriza cada accion en el sistema.
model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime @db.Timestamptz(6)
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token], map: "idx_session_token")
  @@index([userId], map: "idx_session_userid")
  @@map("session")
}

/// Credenciales por proveedor. Para email+password guarda el hash en password.
model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  /// Identificador del emisor que usa Better Auth 1.7 (ej: local:credential).
  issuer                String?
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(6)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(6)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId], map: "uq_account_provider")
  @@index([userId], map: "idx_account_userid")
  @@map("account")
}

/// Tokens de un solo uso: verificacion de correo y reset de contrasena.
model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@index([identifier], map: "idx_verification_identifier")
  @@map("verification")
}

/// El segundo factor de un usuario: el secreto TOTP que comparte con su app de
/// autenticacion y los codigos de respaldo para cuando pierde el telefono.
///
/// `failedVerificationCount` y `lockedUntil` frenan la fuerza bruta contra el
/// codigo: seis digitos se adivinan rapido si se puede intentar sin limite.
model TwoFactor {
  id                      String    @id @default(cuid())
  userId                  String
  secret                  String
  backupCodes             String
  verified                Boolean   @default(false)
  failedVerificationCount Int       @default(0)
  lockedUntil             DateTime? @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_two_factor_userid")
  @@map("twoFactor")
}

/// Contador de peticiones por clave (IP + ruta). Better Auth lo usa para frenar
/// la fuerza bruta contra el login.
///
/// Vive en la base y no en memoria porque con varias instancias cada una
/// tendria su propio contador, y bastaria repartir los intentos entre ellas
/// para saltarse el limite.
model RateLimit {
  id          String @id @default(cuid())
  key         String @unique
  count       Int
  /// Epoch en milisegundos, no DateTime: asi lo escribe Better Auth.
  lastRequest BigInt

  @@map("rateLimit")
}

// ---------------------------------------------------------------------------
// DATOS DEL MOTOR
//
// Todo lo de aqui abajo ya existe en la base con datos productivos. Se
// describe tal cual: no se renombra ninguna tabla ni se cambia la nulabilidad
// de ninguna columna. Lo unico que este proyecto agrego es
// valida1_results.gestionado_nota.
// ---------------------------------------------------------------------------

model valida1_results {
  id              BigInt    @id @default(autoincrement())
  radicado        String    @unique
  cedula          String?
  request_json    Json?
  response_json   Json?
  created_at      DateTime  @default(now()) @db.Timestamptz(6)
  updated_at      DateTime  @default(now()) @db.Timestamptz(6)
  gestionado_at   DateTime? @db.Timestamptz(6)
  gestionado_by   String?
  /// Observacion que deja el negociador al gestionar (opcional).
  gestionado_nota String?

  /// Override manual del estado. El estado normalmente se DERIVA de los
  /// payloads del motor; cuando este campo tiene valor, gana sobre las reglas
  /// derivadas. Se guarda quien y cuando porque el cambio lo hace una persona y
  /// un estado como `aprobado` implica desembolso: sin traza no hay forma de
  /// auditar quien lo movio. Ponerlo en NULL devuelve la solicitud al estado
  /// derivado, sin perder nada.
  estado_manual    String?
  estado_manual_at DateTime? @db.Timestamptz(6)
  estado_manual_by String?

  credito_decisiones    credito_decisiones?
  document_results      document_results[]
  documentos            documentos[]
  identity_validations  identity_validations?
  motor_data_results    motor_data_results[]
  motor_process_results motor_process_results?
  motor_ejecuciones     motor_ejecuciones[]

  @@index([cedula], map: "idx_valida1_cedula")
}

/// Indice de los archivos subidos. El contenido vive en Azure Blob Storage;
/// aqui solo se guarda el puntero (container + blob_name, al estilo bucket +
/// key de S3) junto con los metadatos y el estado. La FK a valida1_results
/// garantiza que no se pueda adjuntar un documento a una solicitud que no
/// existe.
model documentos {
  id       BigInt @id @default(autoincrement())
  radicado String
  cedula   String

  // Puntero al blob. `container` se guarda explicito para soportar una futura
  // migracion de contenedor sin perder la referencia de los ya existentes.
  container String @default("documentos")
  blob_name String

  // Metadatos del archivo
  nombre_original String
  mime_type       String?
  size_bytes      BigInt?
  /// SHA-256 del contenido: permite detectar que se subio dos veces el mismo
  /// archivo.
  sha256          String? @db.Char(64)
  /// Version del blob en Azure (cambia con cada sobrescritura).
  etag            String?

  /// Tipo/carpeta del documento. Texto libre (p. ej. "Pagare", "Cedula").
  tipo_documento String @default("Documentos generales")

  /// Estado del documento: pendiente | revision | validado (manuales) y
  /// pendiente_firma | firmado (los pone el sistema via ZapSign).
  estado String @default("pendiente")

  // Borrado logico: nunca se borra el blob ni la fila.
  eliminado  Boolean   @default(false)
  deleted_at DateTime? @db.Timestamptz(6)

  subido_por String?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  valida1_results   valida1_results     @relation(fields: [radicado], references: [radicado], onUpdate: NoAction, map: "fk_documentos_valida1")
  firma_solicitudes firma_solicitudes[]

  @@unique([container, blob_name], map: "uq_documentos_blob")
  @@index([radicado], map: "idx_documentos_radicado")
  @@index([cedula], map: "idx_documentos_cedula")
  @@index([radicado, estado], map: "idx_documentos_radicado_estado")
}

/// Envios a firma electronica (ZapSign). Un documento puede tener varios
/// envios (reenvios, intentos fallidos): el vigente es el mas reciente con
/// status "pending". El webhook de ZapSign localiza la fila por
/// `zapsign_token`.
model firma_solicitudes {
  id           BigInt @id @default(autoincrement())
  documento_id BigInt
  radicado     String

  /// Token del documento en ZapSign. Es la llave que trae el webhook.
  zapsign_token   String  @unique
  /// open_id de ZapSign (identificador numerico visible en su panel).
  zapsign_open_id Int?
  /// URL de firma del firmante: se le reenvia si no recibio el correo.
  sign_url        String?
  /// Token del firmante en ZapSign (distinto del token del documento).
  signer_token    String?

  // Datos del firmante tal como se enviaron (el firmante puede editarlos en
  // ZapSign, asi que esto es lo solicitado, no necesariamente lo final).
  firmante_nombre String
  firmante_email  String?
  firmante_phone  String?

  /// Canales por los que ZapSign notifico al firmante.
  canal_email    Boolean @default(true)
  canal_whatsapp Boolean @default(false)

  /// Estado del envio: pending | signed | refused | error.
  status String @default("pending")

  /// etag del blob antes de sobrescribirlo con el PDF firmado: deja rastro de
  /// que existio una version sin firmar (el contenido en si no se conserva).
  etag_original String?

  /// Payload crudo del ultimo webhook recibido (auditoria y diagnostico).
  webhook_json Json?

  enviado_por String?
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  updated_at  DateTime  @updatedAt @db.Timestamptz(6)
  signed_at   DateTime? @db.Timestamptz(6)

  documento documentos @relation(fields: [documento_id], references: [id], onDelete: Cascade, map: "fk_firma_documento")

  @@index([documento_id], map: "idx_firma_documento")
  @@index([radicado], map: "idx_firma_radicado")
  @@index([status], map: "idx_firma_status")
}

model identity_validations {
  id              BigInt           @id @default(autoincrement())
  radicado        String?          @unique(map: "identity_validations_radicado_valida1_key")
  cedula          String?
  request_json    Json?
  response_json   Json?
  created_at      DateTime         @default(now()) @db.Timestamptz(6)
  updated_at      DateTime         @default(now()) @db.Timestamptz(6)
  valida1_results valida1_results? @relation(fields: [radicado], references: [radicado], onUpdate: NoAction, map: "fk_identity_valida1")

  @@index([cedula], map: "idx_identity_cedula")
  @@index([radicado], map: "idx_identity_radicado")
}

model motor_data_results {
  id              BigInt           @id @default(autoincrement())
  radicado        String?
  cedula          String?
  request_json    Json?
  response_json   Json?
  created_at      DateTime         @default(now()) @db.Timestamptz(6)
  updated_at      DateTime         @default(now()) @db.Timestamptz(6)
  valida1_results valida1_results? @relation(fields: [radicado], references: [radicado], onUpdate: NoAction, map: "fk_motor_data_valida1")

  @@index([cedula], map: "idx_motor_data_cedula")
  @@index([radicado], map: "idx_motor_data_radicado")
}

model motor_process_results {
  id              BigInt          @id @default(autoincrement())
  radicado        String          @unique
  cedula          String?
  request_json    Json?
  response_json   Json?
  created_at      DateTime        @default(now()) @db.Timestamptz(6)
  updated_at      DateTime        @default(now()) @db.Timestamptz(6)
  valida1_results valida1_results @relation(fields: [radicado], references: [radicado], onDelete: Cascade, onUpdate: NoAction, map: "fk_motor_process_valida1")

  @@index([cedula], map: "idx_motor_process_cedula")
}

/// Historial de ejecuciones del motor. `motor_process_results` guarda solo la
/// vigente (una fila por radicado); aqui queda cada version anterior, incluida
/// la que produjo el motor automatico.
///
/// Antes de sobrescribir la vigente se archiva aqui lo que habia, asi que la
/// fila mas antigua es siempre el original. El diff de campos no se guarda: se
/// calcula comparando dos filas consecutivas, para no duplicar el dato.
model motor_ejecuciones {
  id            BigInt @id @default(autoincrement())
  radicado      String
  request_json  Json?
  response_json Json?

  /// Correo del colaborador que la ejecuto. NULL = la corrio el motor
  /// automatico, no una persona.
  ejecutado_por String?
  created_at    DateTime @default(now()) @db.Timestamptz(6)

  valida1_results valida1_results @relation(fields: [radicado], references: [radicado], onDelete: Cascade, onUpdate: NoAction, map: "fk_motor_ejecuciones_valida1")

  @@index([radicado, created_at(sort: Desc)], map: "idx_motor_ejecuciones_radicado")
}

model credito_decisiones {
  id              BigInt          @id @default(autoincrement())
  radicado        String          @unique
  request_json    Json?
  response_json   Json?
  created_at      DateTime        @default(now()) @db.Timestamptz(6)
  updated_at      DateTime        @default(now()) @db.Timestamptz(6)
  valida1_results valida1_results @relation(fields: [radicado], references: [radicado], onDelete: Cascade, onUpdate: NoAction, map: "fk_credito_valida1")
}

model document_results {
  id              BigInt           @id @default(autoincrement())
  radicado        String?
  cedula          String?
  request_json    Json?
  response_json   Json?
  created_at      DateTime         @default(now()) @db.Timestamptz(6)
  updated_at      DateTime         @default(now()) @db.Timestamptz(6)
  valida1_results valida1_results? @relation(fields: [radicado], references: [radicado], onUpdate: NoAction, map: "fk_document_valida1")

  @@index([cedula], map: "idx_document_cedula")
  @@index([radicado], map: "idx_document_radicado")
}

model datos_asociado {
  id                    BigInt   @id @default(autoincrement())
  cedula                String   @unique
  primer_apellido       String?
  nombre                String?
  nombre_asociado       String?
  ciudad                String?
  cliente_empresa       String?
  estado_civil          String?
  estado_civil_norm     String?
  tipo_vivienda         String?
  nivel                 String?
  usuario_credito       String?
  fecha_ingreso         String?
  fecha_ingreso_empresa String?
  edad                  Decimal? @db.Decimal
  personas_cargo        Decimal? @db.Decimal
  antiguedad_coop       Decimal? @db.Decimal
  antiguedad_laboral    Decimal? @db.Decimal
  salario               Decimal? @db.Decimal
  aportes               Decimal? @db.Decimal
  deuda_coopvalili      Decimal? @db.Decimal
  cuota_disponible      Decimal? @db.Decimal
  created_at            DateTime @default(now()) @db.Timestamptz(6)
  updated_at            DateTime @default(now()) @db.Timestamptz(6)

  @@index([cedula], map: "idx_datos_asociado_cedula")
}
